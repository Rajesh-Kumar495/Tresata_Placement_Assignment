# Copy to .env (git-ignored) and fill in. Never commit .env.  (ADR-019)

# Required for any EDGAR download. SEC fair-access policy requires a declared
# contact, e.g. "Your Name your.email@example.com". No default is provided.
SEC_EDGAR_USER_AGENT=

# LLM endpoint (OpenAI-compatible) - needed from build step 4 onward.
GOEDEL_API_KEY=
GOEDEL_URL=
LLM_MODEL_ID=
